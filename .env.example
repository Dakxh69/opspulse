# OpsPulse Environment Variables — EXAMPLE ONLY
# Copy this to .env and fill in real values.
# NEVER commit .env to version control.
# =============================================================================

# --- PostgreSQL ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=opspulse
POSTGRES_USER=opspulse
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- Backend ---
SECRET_KEY=CHANGE_ME_AT_LEAST_32_RANDOM_CHARS
DEBUG=false
LOG_LEVEL=INFO
ALLOWED_ORIGINS=http://localhost:5173

# --- First Admin bootstrap (used by seed CLI command only) ---
# The seed command reads these; they are not runtime secrets for the API.
FIRST_ADMIN_EMAIL=admin@example.com
FIRST_ADMIN_PASSWORD=CHANGE_ME_STRONG_ADMIN_PASSWORD

# --- Celery ---
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# --- Agent (agent-side only; not used by backend) ---
# AGENT_ID=<uuid assigned by backend>
# AGENT_SECRET=<secret returned once at provisioning>
# BACKEND_BASE_URL=http://localhost:8000

# --- Metric retention ---
METRIC_RAW_RETENTION_DAYS=7
METRIC_AGGREGATE_RETENTION_DAYS=30

